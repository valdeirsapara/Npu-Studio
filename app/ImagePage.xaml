<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NpuStudio.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="32,12,32,20" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controls -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="0,0,12,0">
                <TextBlock Text="Imagem" Style="{StaticResource TitleTextBlockStyle}" />
                <ComboBox x:Name="ModelCombo" Header="Modelo" PlaceholderText="Escolha um modelo de imagem"
                          HorizontalAlignment="Stretch" />
                <ComboBox x:Name="DeviceCombo" Header="Dispositivo" HorizontalAlignment="Stretch" />
                <TextBox x:Name="PromptBox" Header="Descreva a imagem" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="110" PlaceholderText="ex.: a cozy cabin in a snowy forest at night, digital painting" />
                <TextBox x:Name="NegativeBox" Header="Evitar (opcional)" PlaceholderText="ex.: blurry, text, watermark" />
                <ComboBox x:Name="SizeCombo" Header="Tamanho" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <x:String>512 × 512</x:String>
                    <x:String>768 × 512</x:String>
                    <x:String>512 × 768</x:String>
                    <x:String>768 × 768</x:String>
                    <x:String>1024 × 1024</x:String>
                </ComboBox>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="StepsBox" Header="Passos (0 = auto)" Value="0" Minimum="0" Maximum="100"
                               SpinButtonPlacementMode="Compact" />
                    <NumberBox x:Name="SeedBox" Grid.Column="1" Header="Seed (0 = aleatória)" Value="0" Minimum="0"
                               SpinButtonPlacementMode="Compact" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GenerateButton" AutomationProperties.Name="Gerar" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            Click="Generate_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Gerar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" IsEnabled="False" Click="Cancel_Click" />
                </Grid>
                <ProgressBar x:Name="Progress" Value="0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Erro" />
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                <Grid>
                    <Image x:Name="Preview" Stretch="Uniform" />
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xEB9F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyText" Text="Descreva uma imagem e clique em Gerar."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Click="OpenFolder_Click" AutomationProperties.Name="Abrir pasta">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Abrir pasta" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Recent images of this session -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel x:Name="HistoryPanel" Orientation="Horizontal" Spacing="8" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
