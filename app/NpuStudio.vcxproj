    <Page Include="ChatPage.xaml" />
    <Page Include="ImagePage.xaml" />
    <Page Include="ModelsPage.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp"><PrecompiledHeader>Create</PrecompiledHeader></ClCompile>
    <ClCompile Include="App.xaml.cpp"><DependentUpon>App.xaml</DependentUpon></ClCompile>
    <ClCompile Include="MainWindow.xaml.cpp"><DependentUpon>MainWindow.xaml</DependentUpon></ClCompile>
    <ClCompile Include="ChatPage.xaml.cpp"><DependentUpon>ChatPage.xaml</DependentUpon></ClCompile>
    <ClCompile Include="ImagePage.xaml.cpp"><DependentUpon>ImagePage.xaml</DependentUpon></ClCompile>
    <ClCompile Include="ModelsPage.xaml.cpp"><DependentUpon>ModelsPage.xaml</DependentUpon></ClCompile>
    <ClCompile Include="AppState.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="MainWindow.idl"><SubType>Code</SubType><DependentUpon>MainWindow.xaml</DependentUpon></Midl>
    <Midl Include="ChatPage.idl"><SubType>Code</SubType><DependentUpon>ChatPage.xaml</DependentUpon></Midl>
    <Midl Include="ImagePage.idl"><SubType>Code</SubType><DependentUpon>ImagePage.xaml</DependentUpon></Midl>
    <Midl Include="ModelsPage.idl"><SubType>Code</SubType><DependentUpon>ModelsPage.xaml</DependentUpon></Midl>
  </ItemGroup>
  <!-- Copy the OpenVINO runtime DLLs next to the .exe so the app runs without setupvars. -->
  <Target Name="CopyOpenVinoRuntime" AfterTargets="Build">
    <ItemGroup>
      <OvDll Include="$(OpenVinoRoot)\runtime\bin\intel64\Release\*.dll;$(OpenVinoRoot)\runtime\bin\intel64\Release\*.json;$(OpenVinoRoot)\runtime\3rdparty\tbb\bin\*.dll" Exclude="$(OpenVinoRoot)\runtime\3rdparty\tbb\bin\*_debug.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OvDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
